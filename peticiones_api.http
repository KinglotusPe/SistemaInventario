### =========================================================================
### SISTEMA DE INVENTARIO - PRUEBAS DE ENDPOINTS REST Y REGISTRO JSON
### =========================================================================

@baseUrl = http://localhost:8080/api

### -------------------------------------------------------------------------
### 1. LOGIN DE ADMINISTRADOR (Obtener Token JWT)
### -------------------------------------------------------------------------
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Admin123*"
}

### Guardar el token de la respuesta anterior
@authToken = {{loginAdmin.response.body.token}}


### -------------------------------------------------------------------------
### 2. CREAR NUEVO USUARIO MEDIANTE JSON (Requiere Token de Administrador)
### -------------------------------------------------------------------------
POST {{baseUrl}}/usuarios
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "username": "cajero.nuevo",
  "password": "Password123*",
  "nombres": "Mateo",
  "apellidos": "Rojas",
  "email": "mateo.rojas@tienda.pe",
  "telefono": "+51 987654321",
  "rol": "ROLE_CAJERO_VENDEDOR"
}


### -------------------------------------------------------------------------
### 3. DEMOSTRACIÓN DE SEGURIDAD RBAC (Sin Token - Debe responder 401 Unauthorized)
### -------------------------------------------------------------------------
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "username": "hacker",
  "password": "Password123*",
  "nombres": "Intruso",
  "apellidos": "Test",
  "email": "intruso@test.pe",
  "rol": "ROLE_ADMINISTRADOR"
}


### -------------------------------------------------------------------------
### 4. LISTAR USUARIOS (GET)
### -------------------------------------------------------------------------
GET {{baseUrl}}/usuarios
Authorization: Bearer {{authToken}}


### -------------------------------------------------------------------------
### 5. IMPORTAR PRODUCTOS EN LOTE MEDIANTE JSON (Catálogo)
### -------------------------------------------------------------------------
POST {{baseUrl}}/productos/importar-json
Authorization: Bearer {{authToken}}
Content-Type: application/json

[
  {
    "codigoSku": "SKU-MON-001",
    "nombre": "Monitor Gamer Asus ROG 27 165Hz",
    "descripcion": "Panel Fast IPS 1ms QHD HDR400",
    "precioVenta": 1399.00,
    "precioCompra": 950.00,
    "stockMinimo": 3,
    "stockActual": 12,
    "codigoBarras": "7759876543210",
    "categoriaId": 1
  },
  {
    "codigoSku": "SKU-KB-002",
    "nombre": "Teclado Mecanico RGB Redragon",
    "descripcion": "Switches Blue, Retroiluminado RGB",
    "precioVenta": 199.90,
    "precioCompra": 120.00,
    "stockMinimo": 5,
    "stockActual": 25,
    "codigoBarras": "7759876543211",
    "categoriaId": 1
  }
]


### -------------------------------------------------------------------------
### 6. CONSULTAR CATÁLOGO DE PRODUCTOS (GET)
### -------------------------------------------------------------------------
GET {{baseUrl}}/productos
Authorization: Bearer {{authToken}}


### -------------------------------------------------------------------------
### 7. REGISTRAR MOVIMIENTO EN KARDEX MEDIANTE JSON (Entrada por Compra)
### -------------------------------------------------------------------------
POST {{baseUrl}}/movimientos
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "almacenId": 1,
  "tipo": "ENTRADA_COMPRA",
  "productoId": 1,
  "cantidad": 10,
  "motivo": "Recepción de Orden de Compra OC-2026-001"
}


### -------------------------------------------------------------------------
### 8. REGISTRAR MOVIMIENTO EN KARDEX MEDIANTE JSON (Salida por Merma)
### -------------------------------------------------------------------------
POST {{baseUrl}}/movimientos
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "almacenId": 1,
  "tipo": "SALIDA_MERMA",
  "productoId": 1,
  "cantidad": 1,
  "motivo": "Baja de producto por daño físico en embalaje"
}


### -------------------------------------------------------------------------
### 9. CONSULTAR HISTORIAL DE KARDEX (GET)
### -------------------------------------------------------------------------
GET {{baseUrl}}/movimientos
Authorization: Bearer {{authToken}}
